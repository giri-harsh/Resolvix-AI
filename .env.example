# Resolvix Unified Environment Configuration (.env)

# ==============================================================================
# Member A: Voice Runtime & Agora Telephony
# ==============================================================================
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
SHIM_API_KEY=change-me
SERVICE_KEY=change-me
OPS_API_URL=http://localhost:8100
BRAIN_IMPL=mock                  # mock | real
TELEPHONY_MODE=mock              # mock | agora
TELEPHONY_TRANSFER_SUCCESS=true

# Agora Conversational AI & RTC
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ASR / TTS
ASR_VENDOR=deepgram
ASR_API_KEY=
ASR_LANGUAGE=en                    # en (English-only for Phase 1.1) | multi | hi
ASR_MODEL=nova-3
ASR_CREDENTIAL_MODE=byok          # byok | managed
TTS_VENDOR=elevenlabs
TTS_API_KEY=
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB
TTS_CREDENTIAL_MODE=byok          # byok | managed

# ==============================================================================
# Member B: Brain (Knowledge, Groq CAG, Embeddings)
# ==============================================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
KB_TOKEN_BUDGET=90000
KB_EXPORT_SERVICE_KEY=change-me
KB_SOURCE=url:http://localhost:8100/v1/kb/export
LLM_MODE=mock                    # mock | live

# ==============================================================================
# Member C: Ops API, SMS Service & Staff Dashboard
# ==============================================================================
OPS_PORT=8100
OPS_PUBLIC_URL=http://localhost:8100
DATABASE_URL=sqlite:///ops/data/resolvix.db
SEED_PASSWORD=DemoPassword123!
NOTIFY_MODE=mock                 # mock | live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RUNTIME_MODE=mock                # mock | live
RUNTIME_URL=http://localhost:8000
SESSION_SECRET=change-me-session-secret
VITE_OPS_API_URL=http://localhost:8100
