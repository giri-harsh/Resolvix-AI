# Copy to integration/.env (git-ignored) or let integration/run_all.ps1 create it with random LOCAL-ONLY values.
# ONE service key is used everywhere: ops SERVICE_KEY == runtime SERVICE_KEY == brain KB_EXPORT_SERVICE_KEY (run_all.ps1 copies it).
SERVICE_KEY=
SHIM_API_KEY=
SESSION_SECRET=            # ops only, 32+ chars
SEED_PASSWORD=             # dashboard login password for admin@demo, exam@demo, accounts@demo, hostel@demo
GROQ_API_KEY=              # optional; only for run_all.ps1 -LlmMode live
# RUNTIME_MODE=live        # optional: makes the dashboard Publish button call the runtime's /admin/kb/reload (J6 demo)

# ---- Outbound phone calling (mock-only build: nothing here places a real call; see integration/OUTBOUND_RUNBOOK.md) ----
# The runtime reads only integration/.env (via run_all.ps1); voice-runtime/.env is not loaded by any code.
OUTBOUND_ENABLED=false             # keep false unless you are testing the mock build
OUTBOUND_PROVIDER=mock             # only "mock" is active
OUTBOUND_PUBLIC_BASE_URL=          # https origin Exotel can reach (a stable named tunnel/domain); falls back to PUBLIC_BASE_URL
EXOTEL_CALLER_ID=                  # your ExoPhone in E.164 (the trial ExoPhone on a trial account); also never callable as a destination
# EXOTEL_API_KEY=  EXOTEL_API_TOKEN=  EXOTEL_ACCOUNT_SID=  EXOTEL_BASE_URL=   (NOT read by this build; needed by the future real provider)
# EXOTEL_SIP_TRUNK_ID= and AGORA_SIP_TRUNK_ADDRESS= are not used by the Exotel Connect + Voicebot route
OUTBOUND_MAX_CALL_SECONDS=180
OUTBOUND_ALLOWED_COUNTRY_CODES=91
