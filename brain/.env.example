# Copy to .env (git-ignored). Never commit real keys.
LLM_MODE=live                 # live|mock   (mock needs no network or key)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.2
LLM_TTFT_TIMEOUT_S=3.0
LLM_TOTAL_TIMEOUT_S=6.0
LLM_RETRY_IF_ELAPSED_UNDER_S=1.5
LLM_BENCH_AFTER_EMPTY=2       # empty answers in a row before the primary model is tried second (0 = never)
LLM_BENCH_SECONDS=300
GROQ_BASE_URL=https://api.groq.com/openai/v1
KB_SOURCE=file:../contracts/kb/sample_kb.jsonl     # or url:http://localhost:8100/v1/kb/export
KB_EXPORT_SERVICE_KEY=        # only for url: sources. Must equal the ops-api SERVICE_KEY (sent as X-Service-Key); never commit it
KB_TOKEN_BUDGET=90000
FAQ_TAU_HIT=0.90
FAQ_TAU_SOFT=0.80
FAQ_INDEX_ALL=false           # true: also embed non-FAQ entries' questions for hints
EMBED_MODE=fastembed          # fastembed|lexical (lexical = offline degraded fallback, also used by unit tests)
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_CACHE_DIR=./.cache/fastembed
DEPARTMENTS_FILE=../contracts/config/departments.yaml
URGENCY_RULES_FILE=../contracts/config/urgency_rules.yaml
TIMEZONE=Asia/Kolkata
SESSION_TTL_S=7200
WARMUP_ON_RELOAD=true
